PORT=4000

# Required. Generate a real one with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Recommended, separate from JWT_SECRET. Used to encrypt booking messages
# at rest. Generate with: openssl rand -hex 32
# Falls back to JWT_SECRET if unset — fine for local dev, not for production.
ENCRYPTION_KEY=

CLIENT_ORIGIN=http://localhost:5173

# Optional — leave blank to run entirely on the built-in rule-based AI fallback.
# Set these to enable real LLM-powered chat, search parsing, blurbs, and recommendations.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
